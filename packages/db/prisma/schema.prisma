// ConectaVet — Prisma schema
// Fuente: ANALISIS.md §3. Tipos de dato de la app de telemedicina veterinaria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  VET
  ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum ConsultationStatus {
  WAITING
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VetStatus {
  PENDING
  APPROVED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  firstName           String?
  lastName            String?
  phone               String?
  bio                 String?
  specialty           String?
  role                Role      @default(CLIENT)
  vetStatus           VetStatus @default(PENDING) @map("vet_status")
  isOnline            Boolean   @default(false) @map("is_online")
  tokenVersion        Int       @default(1) @map("token_version")
  isEmailVerified     Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken    String?   @map("email_verify_token")
  emailVerifyExpires  DateTime? @map("email_verify_expires")
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  lastSeen            DateTime? @map("last_seen")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pets                  Pet[]
  consultationsAsClient Consultation[] @relation("ClientConsultations")
  consultationsAsVet    Consultation[] @relation("VetConsultations")
  messages              Message[]
  prescriptions         Prescription[]
  pushTokens            PushToken[]
  notifications         Notification[]
  attachments           Attachment[]
  reviewsAsClient       Review[] @relation("ClientReviews")
  reviewsAsVet          Review[] @relation("VetReviews")
  favoriteVets          FavoriteVet[] @relation("FavoriteVetClient")
  favoritedBy           FavoriteVet[] @relation("FavoriteVetVet")

  @@map("users")
}

model Pet {
  id                String         @id @default(cuid())
  name              String
  species           String
  breed             String?
  age               Int?
  weight            Float?
  photoUrl          String?
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consultations     Consultation[]
  deletedAt         DateTime?      @map("deleted_at")
  weightKg          Float?
  sex               Sex?
  color             String?
  microchip         String?
  allergies         String[]
  chronicConditions String[]
  birthDate         DateTime?
  isDeceased        Boolean        @default(false) @map("is_deceased")
  deathDate         DateTime?      @map("death_date")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId])
  @@index([species])
  @@map("pets")
}

model Consultation {
  id        String             @id @default(cuid())
  clientId  String
  client    User               @relation("ClientConsultations", fields: [clientId], references: [id])
  vetId     String?
  vet       User?              @relation("VetConsultations", fields: [vetId], references: [id])
  petId     String
  pet       Pet                @relation(fields: [petId], references: [id])
  status    ConsultationStatus @default(WAITING)
  notes     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?          @map("deleted_at")

  messages      Message[]
  prescriptions Prescription[]
  review        Review?
  attachments   Attachment[]

  @@index([clientId])
  @@index([vetId])
  @@index([status])
  @@index([deletedAt])
  @@map("consultations")
}

model Message {
  id            String       @id @default(cuid())
  consultationId String
  consultation  Consultation @relation(fields: [consultationId], references: [id])
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id])
  content       String
  attachmentUrl String?      @map("attachment_url")
  clientMsgId   String?      @unique @map("client_msg_id")
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?    @map("deleted_at")

  @@index([consultationId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  vetId          String
  vet            User         @relation(fields: [vetId], references: [id])
  content        String
  medication     String?
  dosage         String?
  frequency      String?
  durationDays   String?      @map("duration_days")
  indications    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([consultationId])
  @@map("prescriptions")
}

model Attachment {
  id           String   @id @default(cuid())
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  consultationId String? @map("consultation_id")
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  publicId     String   @unique @map("public_id")
  type         String   // "image" | "video" | "raw"
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  mimeType     String   @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  format       String?
  bytes        Int?
  createdAt    DateTime @default(now())

  @@index([uploaderId])
  @@index([consultationId])
  @@map("attachments")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  consultationId String   @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  clientId       String
  client         User     @relation("ClientReviews", fields: [clientId], references: [id])
  vetId          String
  vet            User     @relation("VetReviews", fields: [vetId], references: [id])
  createdAt      DateTime @default(now())

  @@index([vetId])
  @@index([clientId])
  @@map("reviews")
}

model FavoriteVet {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("FavoriteVetClient", fields: [clientId], references: [id], onDelete: Cascade)
  vetId     String
  vet       User     @relation("FavoriteVetVet", fields: [vetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, vetId])
  @@index([vetId])
  @@map("favorite_vets")
}
