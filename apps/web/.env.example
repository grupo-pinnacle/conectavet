# ConectaVet — apps/web (Next.js + T3)
# Copiá a .env (local) o configurá en Vercel (producción).
# NUNCA commitees .env — está en .gitignore.

# ─── Database (Supabase Postgres) ───────────────────────────────────
# Connection pooling (serverless): puerto 6543 + pgbouncer
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (migrations): puerto 5432
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── NextAuth ───────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generá con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiame-por-un-secret-seguro-de-32-bytes"

# ─── Mobile JWT (para que mobile se autentique vía Bearer) ──────────
# Distinto de NEXTAUTH_SECRET por seguridad. Generá con: openssl rand -base64 32
MOBILE_JWT_SECRET="cambiame-por-otro-secret-distinto-de-32-bytes"

# ─── Cloudinary (media signed uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Supabase Realtime (opcional, F7+) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"