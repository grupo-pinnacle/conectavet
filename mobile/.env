# ─────────────────────────────────────────────
# VetConnect Mobile — Environment variables
# Copy to .env and fill with real values.
# Variables MUST be prefixed with EXPO_PUBLIC_ to be
# exposed to the React Native runtime.
# ─────────────────────────────────────────────

# Backend REST API URL (Express + Prisma)
# Se configura automáticamente al usar start.ps1 (con -ADB usa localhost, sin -ADB usa la IP detectada)
# Si necesitas correr manual: descomentá y cambiá la IP
# EXPO_PUBLIC_API_URL=http://10.20.31.123:3001

# WebSocket endpoint for the queue (realtime)
# EXPO_PUBLIC_WS_URL=ws://10.20.31.123:3001/ws/queue

# LiveKit server URL (cloud or self-hosted)
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Optional — Cloudinary free tier for pet photo uploads
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
