generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  VET
  ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum ConsultationStatus {
  WAITING
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VetStatus {
  PENDING
  APPROVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  firstName    String?
  lastName     String?
  phone        String?
  bio          String?
  specialty    String?
  role         Role
  vetStatus    VetStatus @default(APPROVED) @map("vet_status")
  isOnline     Boolean  @default(false)
  tokenVersion Int      @default(1)
  ratingAvg    Float    @default(0) @map("rating_avg")
  ratingCount  Int      @default(0) @map("rating_count")
  isEmailVerified      Boolean    @default(false) @map("is_email_verified")
  emailVerifyToken     String?    @map("email_verify_token")
  emailVerifyExpires   DateTime?  @map("email_verify_expires")
  passwordResetToken   String?    @map("password_reset_token")
  passwordResetExpires DateTime?  @map("password_reset_expires")
  lastSeen             DateTime? @map("last_seen")
  deletedAt            DateTime? @map("deleted_at")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pets                  Pet[]
  consultationsAsClient Consultation[] @relation("ClientConsultations")
  consultationsAsVet    Consultation[] @relation("VetConsultations")
  messages              Message[]
  prescriptions         Prescription[]
  pushTokens            PushToken[]
  notifications         Notification[]
  attachments           Attachment[]
  reviewsAsClient       Review[]       @relation("ClientReviews")
  reviewsAsVet          Review[]       @relation("VetReviews")
  favoriteVets          FavoriteVet[]  @relation("FavoriteVetClient")
  favoritedBy           FavoriteVet[]  @relation("FavoriteVetVet")

  @@map("users")
  @@index([emailVerifyToken])
  @@index([passwordResetToken])
  @@index([role, isOnline, vetStatus, deletedAt])
}

model Pet {
  id                String         @id @default(cuid())
  name              String
  species           String
  breed             String?
  age               Int?
  weight            Float?
  photoUrl          String?
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consultations     Consultation[]
  deletedAt         DateTime?
  weightKg          Float?
  sex               Sex?
  color             String?
  microchip         String?
  allergies         String[]
  chronicConditions String[]
  birthDate         DateTime?
  isDeceased        Boolean        @default(false)
  deathDate         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId, deletedAt])
  @@index([species])
  @@map("pets")
}

model Consultation {
  id             String             @id @default(cuid())
  clientId       String
  client         User               @relation("ClientConsultations", fields: [clientId], references: [id])
  vetId          String?
  vet            User?              @relation("VetConsultations", fields: [vetId], references: [id])
  petId          String
  pet            Pet                @relation(fields: [petId], references: [id])
  status         ConsultationStatus @default(WAITING)
  notes          String?
  diagnosisNotes String?            @map("diagnosis_notes")
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?          @map("deleted_at")
  messages       Message[]
  prescriptions  Prescription[]
  review         Review?

  @@index([clientId, status, deletedAt])
  @@index([vetId, status, deletedAt])
  @@index([status])
  @@index([deletedAt])
  @@map("consultations")
}

model Message {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  attachmentUrl  String?
  clientMsgId    String?      @map("client_msg_id") @unique
  createdAt      DateTime     @default(now())
  deletedAt      DateTime? @map("deleted_at")

  @@index([consultationId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  vetId          String
  vet            User         @relation(fields: [vetId], references: [id])
  content        String
  medication     String?
  dosage         String?
  frequency      String?
  durationDays   String?
  indications    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([consultationId])
  @@map("prescriptions")
}

model Attachment {
  id         String   @id @default(cuid())
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  url        String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([uploaderId])
  @@map("attachments")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  consultationId String   @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  clientId       String
  client         User     @relation("ClientReviews", fields: [clientId], references: [id])
  vetId          String
  vet            User     @relation("VetReviews", fields: [vetId], references: [id])
  createdAt      DateTime @default(now())

  @@index([vetId])
  @@index([clientId])
  @@map("reviews")
}

model FavoriteVet {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("FavoriteVetClient", fields: [clientId], references: [id], onDelete: Cascade)
  vetId     String
  vet       User     @relation("FavoriteVetVet", fields: [vetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, vetId])
  @@index([vetId])
  @@map("favorite_vets")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  ipAddress String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("audit_logs")
}

