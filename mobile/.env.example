# Copiar a .env con valores reales. NUNCA commitear .env.
# Variables MUST be prefixed with EXPO_PUBLIC_ para exponerse al runtime RN.
# Backend REST API URL. Con start.ps1 se setea automáticamente:
# - con -ADB usa localhost, sin -ADB usa la IP de la LAN.
# EXPO_PUBLIC_API_URL=http://10.20.31.123:3001
# EXPO_PUBLIC_WS_URL=ws://10.20.31.123:3001/socket.io
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=