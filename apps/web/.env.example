# ConectaVet — apps/web (Next.js + T3)
# Copiá a .env y completá. NUNCA commitees .env.
# Variables compartidas con packages/db vía prisma (DATABASE_URL / DIRECT_URL).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambiame-por-un-secret-seguro"

# Cloudinary (media firmado) — pendiente de implementar router
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
