# Database — Pooler (port 6543) para queries en producción
# Prisma + PgBouncer: agregar ?pgbouncer=true&connection_limit=1 a la URL
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.lgdaobhyhnoxznwhqtot:wfEAMXp9c2fVqj37@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.lgdaobhyhnoxznwhqtot:wfEAMXp9c2fVqj37@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# JWT secret key (generar con: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-random-secret"

# Set to "false" to disable refresh token endpoint (feature flag)
REFRESH_TOKENS=true

PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:3000,http://192.168.0.8:8081,http://192.168.0.8:3000,http://10.20.31.123:8081,http://10.20.31.123:3000"
LOG_LEVEL=debug
