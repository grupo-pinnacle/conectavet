# ─────────────────────────────────────────────
# VetConnect Backend — Environment variables
# Copiar a .env con valores reales. NUNCA commitear .env.
# ─────────────────────────────────────────────

# Database — Pooler (port 6543) para queries en producción
# Prisma + PgBouncer: agregar ?pgbouncer=true&connection_limit=10 a la URL.
# Subí connection_limit (antes 1) para soportar concurrencia real (Fase 1.2).
# En PgBouncer "transaction" mode, connection_limit controla el tamaño del pool.
DATABASE_URL="postgresql://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# JWT secret key (generar con: openssl rand -hex 32)
JWT_SECRET=""

# Set to "false" to disable refresh token endpoint (feature flag)
REFRESH_TOKENS=true

PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:3000,http://192.168.0.8:8081,http://192.168.0.8:3000,http://10.20.31.123:8081,http://10.20.31.123:3000"
LOG_LEVEL=debug

# URL de la web (para armar los links de verificación de email / reset de password)
WEB_URL="http://localhost:5173"

# Email (SMTP). Si no se configura, los mails se loguean en consola (modo dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@vetconnect.com"

# ─────────────────────────────────────────────
# Videollamadas — LiveKit Cloud (https://livekit.cloud)
# Crear un proyecto gratis → Project Settings → Keys.
# LIVEKIT_URL: "wss://<proyecto>.livekit.cloud"
# ─────────────────────────────────────────────
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ─────────────────────────────────────────────
# Escalabilidad / tiempo real (Fase 1.1)
# Si REDIS_URL está presente, el gateway Socket.io usa un adapter
# compartido (multi-instancia) y el rate-limit/dedup se vuelve distribuido.
# Dejar vacío para correr en una sola instancia (en memoria).
REDIS_URL=""

# ─────────────────────────────────────────────
# Almacenamiento de media (Fase 1.5)
# "local" (default): disco de la instancia (efímero en PaaS, no usar en prod).
# "s3": sube a S3/compatible y devuelve URL firmada/segura (requiere
#       npm i @aws-sdk/client-s3 y las vars de abajo).
STORAGE_PROVIDER="local"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""

# LiveKit en mobile requiere el host ws (sin el /rtc suffix). Usado por la app
# en desarrollo; en prod se inyecta vía EXPO_PUBLIC_LIVEKIT_URL en eas.json.
LIVEKIT_URL_MOBILE="ws://localhost:7880"

# Expo push (notificaciones). "true" deshabilita el envío real (tests/CI).
EXPO_PUSH_DISABLED="true"

# Endpoint de debug que expone el payload del JWT (S-03). SOLO para debugging
# local. En producción DEBE quedar vacío (endpoint desactivado).
ENABLE_DEBUG_ENDPOINTS="false"