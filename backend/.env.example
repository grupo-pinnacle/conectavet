# ─────────────────────────────────────────────
# VetConnect Backend — Environment variables
# Copiar a .env con valores reales. NUNCA commitear .env.
# ─────────────────────────────────────────────

# Database — Pooler (port 6543) para queries en producción
# Prisma + PgBouncer: agregar ?pgbouncer=true&connection_limit=1 a la URL
DATABASE_URL="postgresql://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# JWT secret key (generar con: openssl rand -hex 32)
JWT_SECRET=""

# Set to "false" to disable refresh token endpoint (feature flag)
REFRESH_TOKENS=true

PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:3000,http://192.168.0.8:8081,http://192.168.0.8:3000,http://10.20.31.123:8081,http://10.20.31.123:3000"
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Videollamadas — LiveKit Cloud (https://livekit.cloud)
# Crear un proyecto gratis → Project Settings → Keys.
# LIVEKIT_URL: "wss://<proyecto>.livekit.cloud"
# ─────────────────────────────────────────────
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""